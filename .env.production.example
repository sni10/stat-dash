# Production .env for ~/stat-dash on the server (next to compose.prod.yaml), chmod 600. Never commit the real file.
# Values marked GENERATE are created on the server, e.g.:  openssl rand -base64 48

# Image to run (commit SHA): set by deploy/deploy.sh
IMAGE_TAG=

# Web port on the server: the server's Tailscale IP (tailnet only), or 127.0.0.1 (SSH tunnel). Not 0.0.0.0: that
# opens it to the internet over plain HTTP (the login password unencrypted, and Docker bypasses ufw).
WEB_BIND=127.0.0.1
WEB_PORT=8010

DJANGO_SECRET_KEY=GENERATE
DJANGO_DEBUG=false
# Host names the browser uses: the Tailscale IP (= WEB_BIND), localhost for an SSH tunnel
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=stat_dash
DB_USER=stat_dash
DB_PASSWORD=GENERATE

# Weekly collection spread out: ~400 requests x 10-20 s = 1.5-2 hours at night instead of 20 minutes
LUN_PAUSE_MIN=10
LUN_PAUSE_MAX=20

# Alerts (collection failures, LUN format changes, Cloudflare blocks); empty -> log only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DASHBOARD_DEFAULT_CITY=odesa
BACKUP_KEEP=8
