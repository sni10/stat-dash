# Copy to .env. Compose reads it for all services; `uv run` on the host reads it too (DB on 127.0.0.1:5435).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=stat_dash
DB_USER=stat_dash
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5435

# Seconds between requests to the source
LUN_PAUSE_MIN=2
LUN_PAUSE_MAX=5

# Alerts; empty -> log only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Number of pg_dump files to keep (compose sets BACKUP_DIR=/backups -> ./backups on the host)
BACKUP_KEEP=8

# Dashboard city when the URL names none
DASHBOARD_DEFAULT_CITY=odesa
